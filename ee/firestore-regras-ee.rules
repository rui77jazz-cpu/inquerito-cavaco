rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Inquérito dos EE: qualquer pessoa com o link pode ENVIAR uma resposta,
    // mas ninguém a pode ler, alterar ou apagar a partir da página.
    // As respostas só se veem na Consola do Firebase (com a conta do Rui).
    match /inqueritos_ee/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['enviadoEm','codigo','respostas','dados'])
                    && request.resource.data.enviadoEm == request.time;
      allow read, update, delete: if false;
    }
  }
}
